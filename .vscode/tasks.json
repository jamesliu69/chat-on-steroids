        "command": "npm.cmd"
      },
      "args": ["run", "dist:win:portable"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "打包 Raspberry Pi 5 (Linux ARM64)",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": ["run", "dist:linux:arm64"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
